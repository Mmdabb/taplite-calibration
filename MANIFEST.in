include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
recursive-include docs *.md
recursive-include examples *.toml *.md *.py *.csv *.npz
recursive-include tests *.py
recursive-include native *.cpp *.h *.md *.txt LICENSE CMakeLists.txt
recursive-include .github *.yml
global-exclude *.pyd *.so *.dll *.dylib *.exe *.obj *.o
global-exclude __pycache__/* *.pyc *.egg-info
